# Domain(s) Caddy should serve (comma-separated)
# Example: CADDY_HOSTS=legal.example.com,www.legal.example.com
CADDY_HOSTS=legal.example.com

# Email for Let's Encrypt certificate notices
LETSENCRYPT_EMAIL=you@example.com

