OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
DATABASE_PATH=chatbot.db
SESSION_DAYS=30
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POLICY_VERSION=2026-04-16
PRELOAD_EMBEDDINGS=1
EMBEDDINGS_REQUIRE_PREBUILT=0
PARAPHRASE_COUNT=16
MAX_EVIDENCE_CANDIDATES=24
MAX_FINAL_EVIDENCE=6
RETRIEVAL_MODE=dense
DENSE_WEIGHT=0.75
BM25_WEIGHT=0.25
HYBRID_PER_QUERY_K=40
RERANKER_ENABLED=0
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=30
RERANKER_WEIGHT=0.35
MIN_ANSWER_CONFIDENCE=0.35
# Optional persistent cache location (absolute path recommended in deployment)
# EMBEDDINGS_PATH=/var/data/legalchatbot/corpus_emb.pt
# EMBEDDINGS_DIR=/var/data/legalchatbot
SELF_CHECK_ENABLED=1
